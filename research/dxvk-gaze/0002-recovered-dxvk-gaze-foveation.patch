+  void DxvkContext::updateFoveationState() {
+    VkExtent2D fragmentSize = { 1u, 1u };
+
+    // Use the attachment rate only inside foveated render passes; otherwise
+    // keep the 1x1 pipeline rate, which is equivalent to no VRS at all.
+    std::array<VkFragmentShadingRateCombinerOpKHR, 2> combinerOps = {
+      VK_FRAGMENT_SHADING_RATE_COMBINER_OP_KEEP_KHR,
+      m_foveationActive
+        ? VK_FRAGMENT_SHADING_RATE_COMBINER_OP_REPLACE_KHR
+        : VK_FRAGMENT_SHADING_RATE_COMBINER_OP_KEEP_KHR };
+
+    m_cmd->cmdSetFragmentShadingRate(&fragmentSize, combinerOps.data());
+
+  }
