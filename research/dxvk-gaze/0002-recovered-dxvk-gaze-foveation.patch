+  void DxvkContext::updateFoveationGaze(FoveationMap& map) {
+    const volatile DxvkFoveationGaze* gaze = foveationGaze();
+
+    const float ringScale = foveationScale();
+    const bool scaleChanged = std::abs(ringScale - map.ringScale) >= 0.01f;
+
+    if (!gaze || (gaze->seq == map.gazeSeq && !scaleChanged))
+      return;
+
+    const auto& c = DxvkFoveationConfig::get();
+    float uv[4] = { c.centerX, c.centerY, 1.0f - c.centerX, c.centerY };  // lens centres without gaze
+
+    if (gaze->valid)
+      uv[0] = gaze->u[0], uv[1] = gaze->v[0], uv[2] = gaze->u[1], uv[3] = gaze->v[1];
+
+    if (gaze->seq != map.gazeSeq)
+      map.gazeSeq = gaze->seq;
+
+    // Skip sub-texel jitter and limit rebuilds to one per 8 ms.
+    float moved = 0.0f;
+
+    for (uint32_t i = 0; i < 4u; i++)
+      moved = std::max(moved, std::abs(uv[i] - map.gazeUV[i]));
+
+    uint64_t now = GetTickCount64();
+
+    if ((moved < 0.01f && !scaleChanged) || now - map.gazeTick < 8u)
+      return;
+
+    std::copy(uv, uv + 4u, map.gazeUV);
+    map.gazeTick = now;
+    map.ringScale = ringScale;
+
+    std::vector<uint8_t> data = buildFoveationMap(map.fbExtent, map.texelSize,
+      map.mapExtent, m_device->properties().khrFragmentShadingRate.maxFragmentSize, uv, ringScale);
+    uploadFoveationMap(map, data);
+  }
