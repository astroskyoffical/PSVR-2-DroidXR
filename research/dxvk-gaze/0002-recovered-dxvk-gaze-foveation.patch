+  void DxvkContext::uploadFoveationMap(
+          FoveationMap&               map,
+    const std::vector<uint8_t>&       data) {
+    DxvkBufferCreateInfo bufferInfo;
+    bufferInfo.size = align<VkDeviceSize>(data.size(), CACHE_LINE_SIZE);
+    bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    bufferInfo.stages = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    bufferInfo.access = VK_ACCESS_TRANSFER_READ_BIT;
+    bufferInfo.debugName = "Foveation map upload";
+
+    Rc<DxvkBuffer> staging = m_device->createBuffer(bufferInfo,
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    std::memcpy(staging->mapPtr(0), data.data(), data.size());
+
+    // Records into the init / transfer command buffers only, so this
+    // is safe to do while setting up the render pass.
+    uploadImage(map.image, staging, 0u, CACHE_LINE_SIZE, VK_FORMAT_R8_UINT);
+  }
