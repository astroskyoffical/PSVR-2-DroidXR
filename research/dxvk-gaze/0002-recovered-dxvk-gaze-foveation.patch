+  const DxvkContext::FoveationMap* DxvkContext::getFoveationMap(
+    const DxvkFramebufferInfo&  framebufferInfo) {
+    const auto& config = DxvkFoveationConfig::get();
+    const auto& props = m_device->properties().khrFragmentShadingRate;
+
+    DxvkFramebufferSize fbSize = framebufferInfo.size();
+
+    if (!config.matches(fbSize.width, fbSize.height))
+      return nullptr;
+
+    if (config.requireDepth && !framebufferInfo.getDepthTarget().view)
+      return nullptr;
+
+    for (uint32_t i = 0; i < framebufferInfo.numAttachments(); i++) {
+      VkSampleCountFlagBits samples = framebufferInfo.getAttachment(i).view->image()->info().sampleCount;
+
+      if (uint32_t(samples) > uint32_t(props.maxFragmentShadingRateRasterizationSamples))
+        return nullptr;
+    }
+
+    for (auto& map : m_foveationMaps) {
+      if (map.fbExtent.width == fbSize.width && map.fbExtent.height == fbSize.height) {
+        if (map.image == nullptr)
+          return nullptr;
+        updateFoveationGaze(map);
+        return &map;
+      }
+    }
+
+    FoveationMap map = { };
+    map.fbExtent = VkExtent2D { fbSize.width, fbSize.height };
+    map.texelSize = props.minFragmentShadingRateAttachmentTexelSize;
+
+    if (!map.texelSize.width || !map.texelSize.height) {
+      // Remember the failure so that we don't retry every render pass
+      m_foveationMaps.push_back(map);
+      return nullptr;
+    }
+
+    VkExtent2D mapExtent = {
+      (fbSize.width  + map.texelSize.width  - 1u) / map.texelSize.width,
+      (fbSize.height + map.texelSize.height - 1u) / map.texelSize.height };
+
+    map.mapExtent = mapExtent;
+
+    std::vector<uint8_t> data = buildFoveationMap(map.fbExtent,
+      map.texelSize, mapExtent, props.maxFragmentSize);
+
+    DxvkImageCreateInfo imageInfo;
+    imageInfo.type = VK_IMAGE_TYPE_2D;
+    imageInfo.format = VK_FORMAT_R8_UINT;
+    imageInfo.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.extent = VkExtent3D { mapExtent.width, mapExtent.height, 1u };
+    imageInfo.numLayers = 1u;
+    imageInfo.mipLevels = 1u;
+    imageInfo.usage = VK_IMAGE_USAGE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR
+                    | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    imageInfo.stages = VK_PIPELINE_STAGE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR;
+    imageInfo.access = VK_ACCESS_FRAGMENT_SHADING_RATE_ATTACHMENT_READ_BIT_KHR;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.layout = VK_IMAGE_LAYOUT_FRAGMENT_SHADING_RATE_ATTACHMENT_OPTIMAL_KHR;
+    imageInfo.debugName = "Foveation map";
+
+    map.image = m_device->createImage(imageInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    uploadFoveationMap(map, data);
+
+    DxvkImageViewKey viewKey;
+    viewKey.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    viewKey.usage = VK_IMAGE_USAGE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR;
+    viewKey.format = VK_FORMAT_R8_UINT;
+    viewKey.layout = VK_IMAGE_LAYOUT_FRAGMENT_SHADING_RATE_ATTACHMENT_OPTIMAL_KHR;
+    viewKey.aspects = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewKey.mipIndex = 0u;
+    viewKey.mipCount = 1u;
+    viewKey.layerIndex = 0u;
+    viewKey.layerCount = 1u;
+
+    map.view = map.image->createView(viewKey);
+
+    // Histogram by fragment area (1, 2, 4, 8, 16 px) and debug dot rects.
+    // Dots are 4x4 px every 16 px, sampled from the map at the dot origin.
+    std::array<uint32_t, 5> histogram = { };
+
+    for (uint8_t v : data)
+      histogram[((v >> 2) & 3u) + (v & 3u)] += 1u;
+
+    if (config.debug) {
+      for (uint32_t y = 6u; y + 4u <= fbSize.height; y += 16u) {
+        for (uint32_t x = 6u; x + 4u <= fbSize.width; x += 16u) {
+          uint8_t v = data[size_t(y / map.texelSize.height) * mapExtent.width + (x / map.texelSize.width)];
+
+          VkClearRect rect = { };
+          rect.rect.offset = VkOffset2D { int32_t(x), int32_t(y) };
+          rect.rect.extent = VkExtent2D { 4u, 4u };
+          rect.layerCount = 1u;
+
+          map.debugRects[((v >> 2) & 3u) + (v & 3u)].push_back(rect);
+        }
+      }
+    }
+
+    Logger::info(str::format("Foveation: shading rate map for ", fbSize.width, "x", fbSize.height,
+      " target: ", mapExtent.width, "x", mapExtent.height, " texels of ",
+      map.texelSize.width, "x", map.texelSize.height, " px; texels with 1/2/4/8/16 px fragments ",
+      histogram[0], "/", histogram[1], "/", histogram[2], "/", histogram[3], "/", histogram[4]));
+
+    m_foveationMaps.push_back(std::move(map));
+    return &m_foveationMaps.back();
+  }
