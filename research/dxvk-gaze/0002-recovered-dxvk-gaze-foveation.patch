diff --git a/src/dxvk/dxvk_foveation.h b/src/dxvk/dxvk_foveation.h
new file mode 100644
index 0000000..33f7480
--- /dev/null
+++ b/src/dxvk/dxvk_foveation.h
@@ -0,0 +1,395 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "dxvk_include.h"
+
+#include "../util/util_env.h"
+
+#include <windows.h>
+
+namespace dxvk {
+
+  /**
+   * \brief Opt-in fixed foveated rendering (prototype)
+   *
+   * Configured exclusively through environment variables, default OFF:
+   *
+   *   DXVK_FOVEATION=1                 enable
+   *   DXVK_FOVEATION_TARGET=WxH[,WxH]  render target sizes to foveate (required)
+   *   DXVK_FOVEATION_EYES=auto|1|2     2 = side-by-side stereo target, auto
+   *                                    picks 2 if width >= 1.5 * height
+   *   DXVK_FOVEATION_CENTER=x,y        projection centre of the LEFT eye in
+   *                                    normalized eye coordinates (default
+   *                                    0.5,0.5); right eye mirrors x
+   *   DXVK_FOVEATION_RINGS=r:WxH,...   any number of rings, e.g.
+   *                                    0.5:1x1,0.62:1x2,0.72:2x2,0.85:2x4,1.0:4x4
+   *                                    (r normalized, 1.0 = eye half width/
+   *                                    height). A texel uses the first ring
+   *                                    with d < r, else the last ring's rate.
+   *                                    Non-square rates are coarser along the
+   *                                    radial direction (DXVK_FOVEATION_ORIENT=0
+   *                                    disables that).
+   *   DXVK_FOVEATION_RADII=r1,r2       legacy 3-ring form used if RINGS is unset
+   *   DXVK_FOVEATION_RATES=AxB,CxD     (default 0.45,0.75 and 2x2,4x4)
+   *   DXVK_FOVEATION_INVERT_Y=1        mirror the eye centre vertically
+   *   DXVK_FOVEATION_EYE_SWAP=1        mirror the eye centres horizontally
+   *   DXVK_FOVEATION_SWAP_XY=1         transpose the non-square rate encoding
+   *   DXVK_FOVEATION_DEBUG=1           draw 4x4 px dots every 16 px in foveated
+   *                                    passes, coloured by map rate: green 1x1,
+   *                                    cyan 2 px, yellow 4 px, orange 8 px,
+   *                                    red 16 px per fragment
+   *   DXVK_FOVEATION_REQUIRE_DEPTH=0|1 only foveate passes that also bind a
+   *                                    depth attachment (default 1)
+   *   DXVK_FOVEATION_LOG=1             log each distinct render pass
+   *                                    configuration once (size, attachments,
+   *                                    foveated or not) to find the eye target
+   */
+  struct DxvkFoveationRing {
+    float      radius;
+    VkExtent2D rate;
+  };
+
+  struct DxvkFoveationConfig {
+    bool enabled = false;
+    bool requireDepth = true;
+    bool log = false;
+    bool orient = true;
+    bool invertY = false;
+    bool eyeSwap = false;
+    bool swapXY = false;
+    bool debug = false;
+    int  eyes = 0;
+    float centerX = 0.5f;
+    float centerY = 0.5f;
+    std::string gazePath;
+    std::string scalePath;
+    std::vector<DxvkFoveationRing> rings;
+    std::vector<VkExtent2D> targets;
+
+    bool matches(uint32_t w, uint32_t h) const {
+      for (const auto& t : targets) {
+        if (t.width == w && t.height == h)
+          return true;
+      }
+
+      return false;
+    }
+
+    static const DxvkFoveationConfig& get() {
+      static const DxvkFoveationConfig s_config = parse();
+      return s_config;
+    }
+
+  private:
+
+    static bool parseRate(const std::string& s, VkExtent2D* rate) {
+      unsigned a = 0, b = 0;
+
+      if (std::sscanf(s.c_str(), "%ux%u", &a, &b) != 2)
+        return false;
+
+      auto valid = [] (unsigned v) { return v == 1u || v == 2u || v == 4u; };
+
+      if (!valid(a) || !valid(b))
+        return false;
+
+      *rate = VkExtent2D { a, b };
+      return true;
+    }
+
+    static std::vector<std::string> split(const std::string& s, char c) {
+      std::vector<std::string> result;
+      size_t pos = 0;
+
+      while (pos < s.size()) {
+        size_t end = s.find(c, pos);
+        if (end == std::string::npos)
+          end = s.size();
+        result.push_back(s.substr(pos, end - pos));
+        pos = end + 1;
+      }
+
+      return result;
+    }
+
+    static DxvkFoveationConfig parse() {
+      DxvkFoveationConfig c;
+
+      if (env::getEnvVar("DXVK_FOVEATION") != "1")
+        return c;
+
+      for (const auto& t : split(env::getEnvVar("DXVK_FOVEATION_TARGET"), ',')) {
+        unsigned w = 0, h = 0;
+
+        if (std::sscanf(t.c_str(), "%ux%u", &w, &h) == 2 && w && h)
+          c.targets.push_back(VkExtent2D { w, h });
+      }
+
+      if (c.targets.empty()) {
+        Logger::warn("DXVK_FOVEATION=1 but DXVK_FOVEATION_TARGET=WxH is not set, foveation disabled");
+        return c;
+      }
+
+      c.gazePath = env::getEnvVar("DXVK_FOVEATION_GAZE");
+      c.scalePath = env::getEnvVar("DXVK_FOVEATION_SCALE");
+
+      std::string eyes = env::getEnvVar("DXVK_FOVEATION_EYES");
+      c.eyes = (eyes == "1") ? 1 : (eyes == "2") ? 2 : 0;
+
+      float x = 0.0f, y = 0.0f;
+
+      if (std::sscanf(env::getEnvVar("DXVK_FOVEATION_CENTER").c_str(), "%f,%f", &x, &y) == 2
+       && x >= 0.0f && x <= 1.0f && y >= 0.0f && y <= 1.0f) {
+        c.centerX = x;
+        c.centerY = y;
+      }
+
+      for (const auto& r : split(env::getEnvVar("DXVK_FOVEATION_RINGS"), ',')) {
+        size_t colon = r.find(':');
+        DxvkFoveationRing ring = { };
+
+        if (colon != std::string::npos && parseRate(r.substr(colon + 1), &ring.rate)) {
+          ring.radius = float(std::atof(r.substr(0, colon).c_str()));
+          c.rings.push_back(ring);
+        } else {
+          Logger::warn(str::format("Foveation: ignoring ring '", r, "'"));
+        }
+      }
+
+      if (c.rings.empty()) {
+        // Legacy three-ring configuration
+        float r1 = 0.45f, r2 = 0.75f;
+        VkExtent2D mid = { 2u, 2u }, outer = { 4u, 4u };
+
+        if (std::sscanf(env::getEnvVar("DXVK_FOVEATION_RADII").c_str(), "%f,%f", &x, &y) == 2
+         && x > 0.0f && y >= x) {
+          r1 = x;
+          r2 = y;
+        }
+
+        auto rates = split(env::getEnvVar("DXVK_FOVEATION_RATES"), ',');
+
+        if (rates.size() == 2u) {
+          parseRate(rates[0], &mid);
+          parseRate(rates[1], &outer);
+        }
+
+        c.rings = { { r1, { 1u, 1u } }, { r2, mid }, { 1e9f, outer } };
+      }
+
+      std::stable_sort(c.rings.begin(), c.rings.end(),
+        [] (const DxvkFoveationRing& a, const DxvkFoveationRing& b) { return a.radius < b.radius; });
+
+      c.orient = env::getEnvVar("DXVK_FOVEATION_ORIENT") != "0";
+      c.invertY = env::getEnvVar("DXVK_FOVEATION_INVERT_Y") == "1";
+      c.eyeSwap = env::getEnvVar("DXVK_FOVEATION_EYE_SWAP") == "1";
+      c.swapXY = env::getEnvVar("DXVK_FOVEATION_SWAP_XY") == "1";
+      c.debug = env::getEnvVar("DXVK_FOVEATION_DEBUG") == "1";
+      c.requireDepth = env::getEnvVar("DXVK_FOVEATION_REQUIRE_DEPTH") != "0";
+      c.log = env::getEnvVar("DXVK_FOVEATION_LOG") == "1";
+      c.enabled = true;
+
+      std::string list, rings;
+
+      for (const auto& t : c.targets)
+        list += str::format(list.empty() ? "" : ",", t.width, "x", t.height);
+
+      for (const auto& r : c.rings)
+        rings += str::format(rings.empty() ? "" : ",", r.radius, ":", r.rate.width, "x", r.rate.height);
+
+      Logger::info(str::format("Foveation: enabled, targets ", list,
+        ", eyes ", c.eyes ? std::to_string(c.eyes) : std::string("auto"),
+        ", center ", c.centerX, ",", c.centerY, ", rings ", rings,
+        ", orient ", c.orient ? 1 : 0, ", invertY ", c.invertY ? 1 : 0,
+        ", eyeSwap ", c.eyeSwap ? 1 : 0, ", swapXY ", c.swapXY ? 1 : 0,
+        ", debug ", c.debug ? 1 : 0, ", requireDepth ", c.requireDepth ? 1 : 0));
+      return c;
+    }
+
+  };
+
+
+  inline uint32_t foveationLog2(uint32_t v) {
+    return v >= 4u ? 2u : v >= 2u ? 1u : 0u;
+  }
+
+
+  /**
+   * \brief Builds the R8_UINT shading rate map for a render target
+   *
+   * Texel value per VK_KHR_fragment_shading_rate is
+   * (log2(width) << 2) | log2(height).
+   * \param [in] fbExtent Framebuffer size in pixels
+   * \param [in] texel Shading rate attachment texel size
+   * \param [in] mapExtent Size of the map, in texels
+   * \param [in] maxFragment Largest fragment size supported by the device
+   */
+  /**
+   * rief Live gaze for eye-tracked foveation
+   *
+   * DXVK_FOVEATION_GAZE names a file written by the VR runtime (Monado writes
+   * /dev/shm/psvr2-gaze, opened here as Z:\dev\shm\psvr2-gaze):
+   * { uint32 seq, uint32 valid, float u[2], float v[2] }, per eye u right, v down.
+   */
+  struct DxvkFoveationGaze {
+    uint32_t seq;
+    uint32_t valid;
+    float    u[2];
+    float    v[2];
+  };
+
+  inline const volatile DxvkFoveationGaze* foveationGaze() {
+    static const volatile DxvkFoveationGaze* s_gaze = nullptr;
+    static uint64_t s_nextTry = 0u;
+
+    const auto& c = DxvkFoveationConfig::get();
+
+    if (s_gaze || c.gazePath.empty() || GetTickCount64() < s_nextTry)
+      return s_gaze;
+
+    s_nextTry = GetTickCount64() + 1000u;  // the runtime creates the file on first gaze sample
+
+    HANDLE file = CreateFileA(c.gazePath.c_str(), GENERIC_READ,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, 0, nullptr);
+
+    if (file == INVALID_HANDLE_VALUE)
+      return nullptr;
+
+    HANDLE mapping = CreateFileMappingA(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    CloseHandle(file);
+
+    if (!mapping)
+      return nullptr;
+
+    s_gaze = reinterpret_cast<const volatile DxvkFoveationGaze*>(
+      MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(DxvkFoveationGaze)));
+    CloseHandle(mapping);
+
+    if (s_gaze)
+      Logger::info(str::format("Foveation: eye tracking from ", c.gazePath));
+
+    return s_gaze;
+  }
+
+  /**
+   * \brief Dynamic ring scale (DXVK_FOVEATION_SCALE)
+   *
+   * The runtime's foveation controller (Monado PSVR2 SR, frame-time PID + head motion) writes
+   * { uint32 seq, float scale } to /dev/shm/psvr2-fovea; every ring radius is multiplied by it.
+   * 1.0 when unset or not written yet.
+   */
+  struct DxvkFoveationScale {
+    uint32_t seq;
+    float    scale;
+  };
+
+  inline float foveationScale() {
+    static const volatile DxvkFoveationScale* s_scale = nullptr;
+    static uint64_t s_nextTry = 0u;
+    const auto& c = DxvkFoveationConfig::get();
+
+    if (!s_scale && !c.scalePath.empty() && GetTickCount64() >= s_nextTry) {
+      s_nextTry = GetTickCount64() + 1000u;
+      HANDLE file = CreateFileA(c.scalePath.c_str(), GENERIC_READ,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, 0, nullptr);
+
+      if (file != INVALID_HANDLE_VALUE) {
+        HANDLE mapping = CreateFileMappingA(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+        CloseHandle(file);
+
+        if (mapping) {
+          s_scale = reinterpret_cast<const volatile DxvkFoveationScale*>(
+            MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(DxvkFoveationScale)));
+          CloseHandle(mapping);
+        }
+      }
+    }
+
+    float s = s_scale && s_scale->seq ? s_scale->scale : 1.0f;
+    return (s >= 0.5f && s <= 1.5f) ? s : 1.0f;
+  }
+
+  inline std::vector<uint8_t> buildFoveationMap(
+          VkExtent2D            fbExtent,
+          VkExtent2D            texel,
+          VkExtent2D            mapExtent,
+          VkExtent2D            maxFragment,
+    const float*                gazeUV = nullptr,
+          float                 ringScale = 1.0f) {
+    const auto& c = DxvkFoveationConfig::get();
+
+    uint32_t eyes = c.eyes ? uint32_t(c.eyes)
+      : (fbExtent.width * 2u >= fbExtent.height * 3u ? 2u : 1u);
+
+    float eyeW = float(fbExtent.width) / float(eyes);
+    float eyeH = float(fbExtent.height);
+
+    std::vector<uint8_t> data(size_t(mapExtent.width) * mapExtent.height, 0u);
+
+    for (uint32_t y = 0; y < mapExtent.height; y++) {
+      for (uint32_t x = 0; x < mapExtent.width; x++) {
+        // Use the texel point closest to the eye centre so that a texel
+        // only gets a coarser rate if all of its pixels are outside a ring.
+        float x0 = float(x * texel.width);
+        float x1 = float(std::min((x + 1u) * texel.width, fbExtent.width));
+        float y0 = float(y * texel.height);
+        float y1 = float(std::min((y + 1u) * texel.height, fbExtent.height));
+
+        uint32_t eye = std::min(uint32_t(((x0 + x1) * 0.5f) / eyeW), eyes - 1u);
+        bool mirror = (eye == 1u) != c.eyeSwap;
+
+        float cx = (mirror ? 1.0f - c.centerX : c.centerX) * eyeW + float(eye) * eyeW;
+        float cy = (c.invertY ? 1.0f - c.centerY : c.centerY) * eyeH;
+
+        if (gazeUV) {  // eye-tracked: gaze point of this eye in its own image (u right, v down)
+          cx = std::clamp(gazeUV[eye * 2u], 0.0f, 1.0f) * eyeW + float(eye) * eyeW;
+          cy = std::clamp(gazeUV[eye * 2u + 1u], 0.0f, 1.0f) * eyeH;
+          if (c.invertY)
+            cy = eyeH - cy;
+        }
+
+        float px = std::clamp(cx, x0, x1);
+        float py = std::clamp(cy, y0, y1);
+
+        float dx = (px - cx) / (0.5f * eyeW);
+        float dy = (py - cy) / (0.5f * eyeH);
+        float d  = std::sqrt(dx * dx + dy * dy);
+
+        VkExtent2D rate = c.rings.back().rate;
+
+        for (const auto& r : c.rings) {
+          if (d < r.radius * ringScale) {
+            rate = r.rate;
+            break;
+          }
+        }
+
+        // Non-square rates: coarser along the radial direction
+        if (c.orient && rate.width != rate.height) {
+          float ox = std::abs((x0 + x1) * 0.5f - cx) / eyeW;
+          float oy = std::abs((y0 + y1) * 0.5f - cy) / eyeH;
+          uint32_t lo = std::min(rate.width, rate.height);
+          uint32_t hi = std::max(rate.width, rate.height);
+          rate = ox >= oy ? VkExtent2D { hi, lo } : VkExtent2D { lo, hi };
+        }
+
+        uint32_t w = foveationLog2(std::min(rate.width,  std::max(maxFragment.width,  1u)));
+        uint32_t h = foveationLog2(std::min(rate.height, std::max(maxFragment.height, 1u)));
+
+        if (c.swapXY)
+          std::swap(w, h);
+
+        data[size_t(y) * mapExtent.width + x] = uint8_t((w << 2) | h);
+      }
+    }
+
+    return data;
+  }
+
+}
